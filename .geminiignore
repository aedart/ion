# --- System & Dependencies ---
node_modules/
.pnpm-store/
.git/
.turbo/
.vercel/
.vitest-attachments/

# --- Build Outputs (Crucial for Token Saving) ---
dist/
build/
out/
*.tsbuildinfo
*.js.map
*.d.ts

# --- Cache & Temp ---
.eslintcache
.dprintcache
.nyc_output/
coverage/
.temp/
.cache/

# --- Media & Binary (AI cannot process these efficiently) ---
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.pdf
*.zip
*.tar.gz

# --- Environment & Secrets (Security Guardrail) ---
.env
.env.*
*.pem
*.key
auth.json

# --- Documentation Artifacts ---
# Keep .md files, but ignore generated site folders
docs/.vuepress/_site/
docs/.vuepress/.temp
docs/.vuepress/.cache
docs/.vuepress/dist