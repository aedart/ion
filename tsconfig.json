{
    "compilerOptions": {
        "target": "es2025",
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
            "@aedart/contracts": ["./packages/contracts/src/index.ts"],
            "@aedart/contracts/*": ["./packages/contracts/src/*"],
            "@aedart/support": ["./packages/support/src/index.ts"],
            "@aedart/support/*": ["./packages/support/src/*"],
            "@aedart/vuepress-utils": ["./packages/vuepress-utils/src/index.ts"],
            "@aedart/vuepress-utils/*": ["./packages/vuepress-utils/src/*"],
            "@aedart/xyz": ["./packages/xyz/src/index.ts"],
            "@aedart/xyz/utils": ["./packages/xyz/src/utils/index.ts"]
        },
        "noEmit": true,
        "outDir": "dist",

        "strict": true,
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "experimentalDecorators": false,
        "emitDecoratorMetadata": false,
        "useDefineForClassFields": true,

        "lib": ["ESNext", "DOM"]
    }
}
