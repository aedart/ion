{
    "compilerOptions": {
        "target": "esnext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "paths": {
            "@aedart/vuepress-utils": ["./packages/vuepress-utils/src/index.ts"],
            "@aedart/vuepress-utils/*": ["./packages/vuepress-utils/src/*"],
            "@aedart/xyz": ["./packages/xyz/src/index.ts"],
            "@aedart/xyz/utils": ["./packages/xyz/src/utils/index.ts"],
        },
        "noEmit": true,
        "outDir": "dist",

        "strict": true,
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    }
}
