{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "./dist",
        "rootDir": "./src",
        /* Ensure composite doesn't prevent emission */
        "composite": true,
        "incremental": true,
        "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": false
    },
    "include": ["src/**/*"]
}
