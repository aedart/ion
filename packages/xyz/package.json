{
    "name": "@aedart/xyz",
    "version": "0.14.0",
    "description": "A private package used for testing, examples and tinkering",
    "keywords": [
        "Tests",
        "Examples"
    ],
    "author": "Alin Eugen Deac <aedart@gmail.com>",
    "license": "BSD-3-Clause",
    "homepage": "https://aedart.github.io/ion/",
    "bugs": {
        "url": "https://github.com/aedart/ion/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aedart/ion.git",
        "directory": "packages/xyz"
    },
    "private": true,
    "publishConfig": {
        "access": "public",
        "registry": "http://localhost:9999"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./utils": {
            "types": "./dist/utils/index.d.ts",
            "import": "./dist/utils/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "NOTICE",
        "README.md"
    ],
    "scripts": {
        "copy-license": "cp ../../LICENSE ./LICENSE",
        "build": "rm -f *.tsbuildinfo && tsc && node ../../scripts/add-banner.js",
        "type-check": "tsc --noEmit"
    },
    "peerDependencies": {
        "tslib": "^2.8.1"
    },
    "sideEffects": false
}
