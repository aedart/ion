{
    "name": "@aedart/support",
    "version": "0.14.0",
    "description": "The Ion support package",
    "keywords": [
        "Support",
        "Utilities"
    ],
    "author": "Alin Eugen Deac <aedart@gmail.com>",
    "license": "BSD-3-Clause",
    "homepage": "https://aedart.github.io/ion/",
    "bugs": {
        "url": "https://github.com/aedart/ion/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aedart/ion.git",
        "directory": "packages/support"
    },
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "NOTICE",
        "README.md"
    ],
    "scripts": {
        "copy-license": "cp ../../LICENSE ./LICENSE",
        "build": "rm -f *.tsbuildinfo && tsc && node ../../scripts/add-banner.js",
        "type-check": "tsc --noEmit"
    },
    "peerDependencies": {
        "@aedart/contracts": "workspace:*",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@aedart/contracts": "workspace:*"
    },
    "sideEffects": false
}
