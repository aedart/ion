{
    "name": "@aedart/vuepress-utils",
    "version": "0.14.0",
    "description": "A few utilities for Vuepress.",
    "keywords": [
        "Vuepress",
        "Utilities",
        "Archive",
        "Navigation"
    ],
    "author": "Alin Eugen Deac <aedart@gmail.com>",
    "license": "BSD-3-Clause",
    "homepage": "https://aedart.github.io/ion/",
    "bugs": {
        "url": "https://github.com/aedart/ion/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aedart/ion.git",
        "directory": "packages/vuepress-utils"
    },
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./contracts": {
            "types": "./dist/contracts/index.d.ts",
            "import": "./dist/contracts/index.js"
        },
        "./navigation": {
            "types": "./dist/navigation/index.d.ts",
            "import": "./dist/navigation/index.js"
        },
        "./plugins": {
            "types": "./dist/plugins/index.d.ts",
            "import": "./dist/plugins/index.js"
        },
        "./components/*": "./dist/components/*"
    },
    "files": [
        "dist",
        "src",
        "NOTICE",
        "README.md"
    ],
    "peerDependencies": {
        "vue": "^3.5.32",
        "vuepress": "^2.0.0-rc.28",
        "@vuepress/client": "^2.0.0-rc.28",
        "@vuepress/utils": "^2.0.0-rc.28",
        "@vuepress/bundler-vite": "^2.0.0-rc.28",
        "@vuepress/theme-default": "^2.0.0-rc.128",
        "@types/luxon": "^3.4.2",
        "luxon": "^3.5.0",
        "sass": "^1.79.3",
        "tslib": "^2.8.1"
    },
    "scripts": {
        "copy-license": "cp ../../LICENSE ./LICENSE",
        "build": "rm -f *.tsbuildinfo && tsc && node ../../scripts/sync-assets.js && node ../../scripts/add-banner.js",
        "type-check": "tsc --noEmit"
    }
}
