{
    "name": "@aedart/ion-monorepo",
    "description": "Monorepo for JS / TS packages",
    "keywords": [
        "Ion",
        "Library"
    ],
    "author": "Alin Eugen Deac",
    "license": "BSD-3-Clause",
    "bugs": {
        "url": "https://github.com/aedart/ion/issues"
    },
    "homepage": "https://aedart.github.io/ion/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aedart/ion.git"
    },
    "type": "module",
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=9.0.0"
    },
    "dependencies": {
        "@aedart/xyz": "workspace:*",
        "@aedart/vuepress-utils": "workspace:*"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/luxon": "^3.4.2",
        "@types/node": "^22.19.17",
        "@vitest/browser": "^4.1.2",
        "@vitest/browser-playwright": "^4.1.2",
        "@vitest/coverage-istanbul": "^4.1.2",
        "@vitest/coverage-v8": "4.1.2",
        "@vuepress/bundler-vite": "^2.0.0-rc.28",
        "@vuepress/client": "^2.0.0-rc.28",
        "@vuepress/theme-default": "^2.0.0-rc.128",
        "@vuepress/utils": "^2.0.0-rc.28",
        "dprint": "^0.53.2",
        "eslint": "^9.10.0",
        "globals": "^15.15.0",
        "luxon": "^3.5.0",
        "playwright": "^1.48.0",
        "sass": "^1.79.3",
        "tslib": "^2.8.0",
        "turbo": "^2.3.0",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.58.0",
        "vite": "^8.0.3",
        "vitest": "^4.0.0",
        "vue": "^3.5.32",
        "vuepress": "^2.0.0-rc.28"
    },
    "scripts": {
        "version:sync": "node scripts/check-versions.js",
        "version:tag": "node scripts/git-tag.js",
        "fix:imports": "node scripts/fix-esm-imports.js",
        "build": "turbo run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "turbo run lint",
        "lint:fix": "eslint . --fix",
        "format": "dprint check",
        "format:fix": "dprint fmt",
        "type-check": "turbo run type-check && tsc -p tsconfig.json --noEmit",
        "docs:dev": "vuepress dev docs",
        "docs:build": "vuepress build docs",
        "deps:sync-peers": "node scripts/sync-peer-deps.js",
        "deps:propagate": "node scripts/propagate-deps.js",
        "deps:update": "pnpm deps:sync-peers && pnpm deps:propagate && pnpm install",
        "publish-check": "pnpm -r publish --dry-run",
        "publish": "pnpm version:sync && pnpm build && pnpm version:tag && pnpm -r publish --access public"
    },
    "packageManager": "pnpm@10.33.0"
}
